{
  "name": "jsonlogic-formula",
  "version": "0.1.2",
  "description": "JsonLogic parser to and from spreadsheet formula syntax",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "node ./scripts/build.ts && npm run declarations",
    "lint": "oxlint --deny-warnings src scripts && oxfmt --check src scripts",
    "test": "node --test \"src/**/*.test.ts\"",
    "test:csp": "node --disallow-code-generation-from-strings --test \"src/**/*.test.ts\"",
    "benchmark": "node scripts/benchmark.ts",
    "coverage": "node --experimental-test-coverage --test \"src/**/*.test.ts\"",
    "declarations": "tsc --declarationDir dist --emitDeclarationOnly --declaration",
    "postbuild": "cat package.json | sed '/\\\"devDependencies\\\"/,/}/ d; /^$/d' | sed 's/\\.\\/dist\\//\\.\\//g' > ./dist/package.json && cp README.md dist && cp LICENSE dist",
    "format": "oxfmt --write src scripts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Marcisbee/jsonlogic-formula.git"
  },
  "keywords": [
    "jsonlogic",
    "json-logic",
    "spreadsheet",
    "formula",
    "parser"
  ],
  "author": "Marcis <marcisbergmanis@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Marcisbee/jsonlogic-formula/issues"
  },
  "homepage": "https://github.com/Marcisbee/jsonlogic-formula#readme",
  "devDependencies": {
    "@types/node": "^20.8.4",
    "esbuild": "^0.19.4",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "typescript": "^5.2.2"
  },
  "exports": {
    "./package.json": "./dist/package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    }
  }
}
